extends base
include _reviewCard

mixin overviewBox(icon, label, text)
  .overview-box__detail
    svg.overview-box__icon
      use(xlink:href=`/img/icons.svg#icon-${icon}`)
    span.overview-box__label #{label}
    span.overview-box__text #{text}

block append head
  // Includes the Mapbox GL JS CSS stylesheet
  link(href="https://api.mapbox.com/mapbox-gl-js/v3.20.0/mapbox-gl.css" rel="stylesheet")
  // Imports the Mapbox GL JS bundle
  script(src="https://api.mapbox.com/mapbox-gl-js/v3.20.0/mapbox-gl.js")
  script(src='/js/mapbox.js' defer) 
  //- this is an example for static file that will be served by express.static middleware. It will be available in the browser as /js/mapbox.js so it should be in the public otherwise browser will not be able to find it and will throw 404 error. Note you can access pug files in the views folder as response of the requested route but for the browser to get static files like css, js, images you need to put them in the public folder and serve it using express.static middleware. This is a security measure to prevent users from accessing your server files and only allow them to access the files that you want to share with them. You can also use this middleware to serve files from other folders but it's not recommended for security reasons. It's better to keep all your static files in the public folder and serve it from there.

block content
  section.section-header
    .header__hero
      .header__hero-overlay &nbsp;
      img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt='Tour 5')

    .heading-box
      h1.heading-primary
        span= `${tour.name} tour`
      .heading-box__group
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-clock')
          span.heading-box__text #{tour.duration} days
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-map-pin')
          span.heading-box__text #{tour.startLocation.description}

  section.section-description
    .overview-box
      div
        .overview-box__group
          h2.heading-secondary.ma-bt-lg Quick facts
          +overviewBox('calendar', 'Next date', tour.startDates[0].toLocaleDateString('en-US', { month: 'long', year: 'numeric' }))
          +overviewBox('trending-up', 'Difficulty', tour.difficulty)
          +overviewBox('user', 'Participants', `${tour.maxGroupSize} people`)
          +overviewBox('star', 'Rating', `${tour.ratingsAverage} / 5`)

        .overview-box__group
          h2.heading-secondary.ma-bt-lg Your tour guides
          each guid in tour.guides
            .overview-box__detail
              img.overview-box__img(src=`/img/users/${guid.photo}`, alt='Lead guide')
              span.overview-box__label= guid.role==='lead-guide' ? 'Lead guide' : 'Tour guide'
              span.overview-box__text #{guid.name}

    .description-box
      h2.heading-secondary.ma-bt-lg About the park camper tour
      - description = tour.description.split('\n')
      each paragraph in description
        p.description__text= paragraph

  section.section-pictures
    each picture, i in tour.images
      .picture-box
        img.picture-box__img(src=`/img/tours/${picture}`, alt=`${tour.name} tour`, class = `picture-box__img--${i+1}`)
    

  section.section-map
    #map(data-locations=JSON.stringify(tour.locations) data-accesstoken=process.env.MAPBOX_ACCESS_TOKEN)

  section.section-reviews
    .reviews
      each review in tour.reviews
        +reviewCard(review)
              

  section.section-cta
    .cta
      .cta__img.cta__img--logo
        img(src='/img/logo-white.png', alt='Natours logo')
      img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}`, alt='Tour picture')
      img.cta__img.cta__img--2(src=`/img/tours/${tour.images[2]}`, alt='Tour picture')
      .cta__content
        h2.heading-secondary What are you waiting for?
        p.cta__text #{tour.duration} days. 1 adventure. Infinite memories. Make it yours today!
        button.btn.btn--green.span-all-rows Book tour now!